#!/bin/sh
case "$1" in --clean|--pre-restore) ;; *) exit 0 ;; esac
# The cgroup namespace root that zdtm made for the 'cgroupns' flag; it is
# empty once the test is dead, and --manage-cgroups=full recreates it.
path=/sys/fs/cgroup/zdtm-cgroupns-cgroupv2_file_bind
if [ -d "$path" ]; then
	rmdir "$path"
fi
